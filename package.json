{
  "name": "markdownonline",
  "version": "1.0.0",
  "description": "A focused Markdown editor with live preview and LaTeX support.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "markdown",
    "editor",
    "latex",
    "github-pages"
  ],
  "license": "MIT",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "dependencies": {
    "@mdit/plugin-katex": "1.1.3",
    "highlight.js": "11.12.0",
    "katex": "0.18.11",
    "lucide": "1.57.0",
    "markdown-it": "15.0.2",
    "markdown-it-task-lists": "2.1.1"
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "vite": "8.3.4"
  }
}
